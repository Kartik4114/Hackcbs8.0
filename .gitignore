# =====================================================
# 🧠 General Git Ignore for Full-Stack Project
# (Next.js + Node.js + MongoDB + Auth0)
# =====================================================

# === Dependencies ===
node_modules/
backend/node_modules/
frontend/node_modules/

# === Build Outputs ===
build/
dist/
.next/
out/
.cache/
.temp/
coverage/

# === Logs ===
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# === Environment Files ===
.env
.env.local
.env.development
.env.production
.env.test
backend/.env
frontend/.env

# === System / Editor Files ===
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.tmp

# === Vercel / Deployment ===
.vercel/
.vercel_build_output/
.next-output/

# === TypeScript ===
*.tsbuildinfo
next-env.d.ts

# === Uploads / Generated Files ===
uploads/
backend/uploads/
tmp/
temp/

# === Prisma / Database / Migrations (if used) ===
prisma/dev.db
prisma/migrations/

# === Build Cache ===
.npm/
.yarn/
.pnpm-store/
turbo/
eslintcache/

# === Optional: lockfiles (if using multiple package managers) ===
package-lock.json
yarn.lock
pnpm-lock.yaml

# === Misc ===
*.bak
*.old
*.orig
*.rej
